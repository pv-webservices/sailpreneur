{
  "name": "akmics-sailpreneur-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/curate-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "npm run test:unit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.mjs\"",
    "audit:seo": "node scripts/audit-seo.mjs",
    "verify": "node scripts/verify.mjs",
    "check:live": "node scripts/check-live.mjs",
    "qa": "npm run check && npm run build && npm run test:unit && npm run audit:seo",
    "images:generate": "node --env-file=.env scripts/images/generate.mjs",
    "images:optimize": "python scripts/optimize-images.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@netlify/blobs": "^11.1.4",
    "astro": "^7.3.8",
    "nodemailer": "^10.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
