---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import HelpfulLinks from '../components/HelpfulLinks.astro';
---
<Layout noindex title="Page Not Found" description="The page you were looking for could not be found. Find your way back to AKMICS Sailpreneur Academy programs, mentors and contact details.">
  <PageHero title="Let’s get you <em>back on course.</em>" eyebrow="404 — Page not found" intro="We couldn’t find this page. It may have moved, or the link may be mistyped. These pages will help you continue." image="journey-ocean" compact>
    <div class="btn-row"><Button href="/">Return home</Button><Button href="/contact/" variant="ghost">Contact us</Button></div>
  </PageHero>
  <HelpfulLinks heading="Popular pages" />
</Layout>
