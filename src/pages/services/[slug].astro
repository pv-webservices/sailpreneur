---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Img from '../../components/Img.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Services from '../../components/Services.astro';
import CTA from '../../components/CTA.astro';
import { services, brand, tel } from '../../data/site';
import { firstAvailable } from '../../lib/media';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const image = firstAvailable(service.image, service.fallbackImage);
const heroImage = image ?? 'mentorship-session';
---
<Layout title={service.name} description={`${service.text} ${service.name} with AKMICS — Sailpreneur Academy.`} preload={heroImage}>
  <PageHero title={service.name} eyebrow={service.name} intro={service.text} image={heroImage} crumbs={[['/mentorship-program/', 'Programs']]} compact>
    <div class="btn-row"><Button href="/contact/">Enquire about this program</Button></div>
  </PageHero>

  <section class="section">
    <div class="wrap service-layout">
      <div class="service-main" data-reveal>
        <p class="eyebrow">{service.category}</p>
        <h2>{service.label}.</h2>
        <h3 class="service-sub">What the guidance covers</h3>
        <ul class="topic-list">{service.topics.map((topic, i) => <li><span>0{i + 1}</span><p>{topic}</p></li>)}</ul>
        <div class="outcome"><Icon name="award" size={28} stroke={1.3} /><div><strong>Outcome</strong><p>{service.outcome}</p></div></div>
        <p class="service-scope">Part of the wider AKMICS mentorship — your mentor connects this area with your profile, department and the rest of your preparation.</p>
      </div>
      <aside class="service-aside" data-reveal>
        {image && <Img name={image} class="service-aside-img" decorative sizes="(max-width: 900px) 90vw, 30vw" />}
        <div class="service-aside-body">
          <p class="eyebrow">Your next step</p>
          <h2>Bring your questions. <em>Build your direction.</em></h2>
          <p>Talk to the team about the guidance you need and the current batch.</p>
          <Button href="/contact/">Apply now</Button>
          <a class="aside-phone" href={tel(brand.phones[0])}><Icon name="phone" size={18} />{brand.phones[0]}</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <SectionHeading eyebrow="Keep exploring" title="Other <em>programs.</em>" href="/mentorship-program/" linkText="All programs" />
      <Services exclude={service.slug} withCta={false} />
    </div>
  </section>
  <CTA />
</Layout>
