---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Experts from '../../components/Experts.astro';
import CTA from '../../components/CTA.astro';
import { experts } from '../../data/site';
export function getStaticPaths() {
  return experts.map((expert) => ({ params: { slug: expert.slug }, props: { expert } }));
}
const { expert } = Astro.props;
---
<Layout title={`${expert.name} — ${expert.focus}`} description={`Meet ${expert.name}, ${expert.role}, on the AKMICS expert panel. ${expert.text}`}>
  <PageHero title={expert.name} eyebrow={expert.name} intro={expert.role} image="bridge-dusk" portrait={expert.image} portraitAlt={`${expert.name}, ${expert.role}`} crumbs={[['/expert-panel/', 'Expert Panel']]}>
    <div class="btn-row"><Button href="/contact/">Learn with our experts</Button></div>
  </PageHero>

  <section class="section">
    <div class="wrap two-cards">
      <article class="info-card" data-reveal>
        <Icon name="compass" size={30} stroke={1.3} />
        <p class="eyebrow">Areas of focus</p>
        <h2>{expert.focus}</h2>
        <p>{expert.text}</p>
      </article>
      <article class="info-card" data-reveal>
        <Icon name="users" size={30} stroke={1.3} />
        <p class="eyebrow">Mentorship contribution</p>
        <h2>A perspective to learn from.</h2>
        <p>{expert.contribution}</p>
        <p>Contact the academy to discuss how these focus areas relate to your goals and the current panel-session arrangements.</p>
      </article>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <SectionHeading eyebrow="A wider range of perspectives" title="Meet the rest of <em>the panel.</em>" href="/expert-panel/" linkText="Full expert panel" />
      <Experts tone="light" exclude={expert.slug} />
    </div>
  </section>
  <CTA />
</Layout>
