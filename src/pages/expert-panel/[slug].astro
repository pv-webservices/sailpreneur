---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Experts from '../../components/Experts.astro';
import CTA from '../../components/CTA.astro';
import { experts } from '../../data/site';
import { media } from '../../lib/media';
import { person } from '../../lib/seo';
export function getStaticPaths() {
  return experts.map((expert) => ({ params: { slug: expert.slug }, props: { expert } }));
}
const { expert } = Astro.props;
const path = `/expert-panel/${expert.slug}/`;
const description = `Meet ${expert.name}, ${expert.role}, on the AKMICS cruise career expert panel.`;
---
<Layout title={`${expert.name}: ${expert.focus}`} description={description} crumbs={[['/', 'Home'], ['/expert-panel/', 'Expert Panel'], [path, expert.name]]} pageType="ProfilePage" schema={[person(Astro.site!, path, expert.name, expert.role, media(expert.image).src, expert.text)]}>
  <PageHero title={expert.name} eyebrow={expert.years ? `${expert.years}+ years experience` : 'AKMICS expert panel'} intro={expert.role} image="bridge-dusk" portrait={expert.image} portraitAlt={`${expert.name}, ${expert.role}`} crumbs={[['/expert-panel/', 'Expert Panel']]}>
    <div class="btn-row"><Button href="/contact/">Learn with our experts</Button></div>
  </PageHero>

  <section class="section">
    <div class="wrap expert-profile">
      <div class="expert-profile-copy" data-reveal>
        <p class="eyebrow">{expert.focus}</p>
        <h2>{expert.headline}</h2>
        {expert.story.map((para) => <p>{para}</p>)}
      </div>
      <aside class="expert-gives" data-reveal>
        {expert.years && <p class="expert-gives-years"><strong>{expert.years}+</strong><span>years of industry experience</span></p>}
        <Icon name="star" size={30} stroke={1.3} />
        <h3>What you gain</h3>
        <p>{expert.gives}</p>
      </aside>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <SectionHeading eyebrow="A wider range of perspectives" title="Meet the rest of <em>the panel.</em>" href="/expert-panel/" linkText="Full expert panel" />
      <Experts tone="light" exclude={expert.slug} />
    </div>
  </section>
  <CTA />
</Layout>
