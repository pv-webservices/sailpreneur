---
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { departments } from '../data/site';
---
<section class="section">
  <div class="wrap">
    <nav class="pill-nav" aria-label="Departments on this page" data-reveal>
      {departments.map((dept) => <a href={`#${dept.slug}`}>{dept.name}</a>)}
    </nav>
    <div class="dept-rows">
      {departments.map((dept, i) => (
        <article class:list={['dept-row', i % 2 === 1 && 'dept-row--flip']} id={dept.slug}>
          <figure class="dept-row-media" data-reveal><Img name={dept.image} sizes="(max-width: 900px) 90vw, 36vw" /></figure>
          <div class="dept-row-copy" data-reveal>
            <span class="dept-row-num">0{i + 1} / 05</span>
            <h2>{dept.name}</h2>
            <p class="lead">{dept.short}</p>
            <dl>
              <div><dt><Icon name="users" size={20} />Role examples</dt><dd>{dept.roles}</dd></div>
              <div><dt><Icon name="ship" size={20} />The working environment</dt><dd>{dept.text}</dd></div>
              <div><dt><Icon name="compass" size={20} />How AKMICS prepares you</dt><dd>{dept.prepare}</dd></div>
            </dl>
            <a class="btn btn--navy" href={`/contact/?department=${dept.slug}`}><span>Discuss this pathway</span><Icon name="arrow" size={18} /></a>
          </div>
        </article>
      ))}
    </div>
    <aside class="note-card note-card--wide" data-reveal>
      <Icon name="shield" size={30} stroke={1.3} />
      <div>
        <h3>Your background comes first.</h3>
        <p>Exact requirements — education, experience, certification and medical — differ by employer and role. Role examples are for exploration and do not represent current vacancies. Speak with our team about your background and the right department for you.</p>
      </div>
    </aside>
  </div>
</section>
