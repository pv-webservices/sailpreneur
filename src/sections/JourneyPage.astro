---
import Icon from '../components/Icon.astro';
import Journey from '../components/Journey.astro';
---
<section class="section">
  <div class="wrap">
    <Journey expanded />
    <aside class="note-card note-card--wide" data-reveal>
      <Icon name="compass" size={30} stroke={1.3} />
      <div>
        <h3>Your journey is individual.</h3>
        <p>The steps describe how AKMICS prepares and supports you. Recruitment, visa decisions, joining arrangements and promotions depend on employers, authorities and the requirements of each role.</p>
      </div>
    </aside>
  </div>
</section>
