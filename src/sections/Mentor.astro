---
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stories from '../components/Stories.astro';
// Founder story as supplied by the client.
const timeline = [
  { icon: 'graduation', title: 'Hotel Management', text: 'Where the dream found its starting point.' },
  { icon: 'star', title: 'The Grand, New Delhi', text: 'One of India’s most iconic luxury 5-star hotels.' },
  { icon: 'globe', title: 'Dubai', text: 'International exposure in the global capital of hospitality.' },
  { icon: 'ship', title: '11+ years · Royal Caribbean', text: 'Various positions on the world’s largest cruise ships — 50+ countries, 65+ islands.' },
  { icon: 'compass', title: 'Now guiding you', text: 'Founder of AKMICS Sailpreneur Academy.' },
];
const chapters = [
  { label: 'The beginning', title: 'Hospitality is in his blood.', paras: [
    'His passion for hospitality started long before the classroom — in childhood itself. Ankur comes from India, from a culture where we say “Atithi Devo Bhava — Guest is God.” For him, hospitality is not a profession. Since childhood he has lived it: welcoming people, respecting guests, taking care of them as family. He knows hospitality because he was born in it.',
    'After completing his Hotel Management studies, Ankur Kumar Mishra didn’t chase shortcuts. He chose the hard path — excellence.',
  ] },
  { label: 'The Grand, New Delhi', title: 'Learning what real hospitality means.', paras: [
    'His first chapter was written at The Grand, New Delhi — one of India’s most iconic luxury 5-star hotels. There, he learned what real hospitality means: precision, discipline, guest obsession and the standard of true luxury.',
  ] },
  { label: 'Dubai', title: 'Hospitality is a global language.', paras: [
    'But he wanted to see the world. He moved to Dubai, the global capital of hospitality, and gained international exposure — working with diverse cultures, international guests and global hospitality standards.',
    'It changed his perspective forever. He realised hospitality is not a local skill. It’s a global language.',
  ] },
  { label: 'Royal Caribbean International', title: 'The dream job at sea — for 11+ years.', paras: [
    'Then came the dream he had been waiting for: Royal Caribbean International, the world’s leading cruise line. He stayed for more than 11 years — not in one position, but in many. Growing, learning, leading, failing and rising again, from a junior role to handling responsibilities on one of the largest floating cities in the world.',
    'Six months at sea, thousands of guests, 16-hour shifts, promotions, challenges — the real sea life that no YouTube video can ever teach. He travelled to 50+ countries and 65+ islands, from Europe to the Caribbean and from Alaska to Asia, and saw hospitality in every culture: how the Japanese welcome, how Europeans serve, how Americans celebrate and how Indians care.',
    'He learnt from the best — General Managers, Hotel Directors and Cruise Directors who have managed 6,000+ guests and 2,000+ crew at sea. This is the experience no book, no video and no fake agent can ever give.',
  ] },
  { label: 'Coming home', title: 'What about the students back home?', paras: [
    'After 11+ years at sea, he had everything — but one question was left. He saw hospitality graduates getting scammed by fake agents. He saw students with dreams but no right guidance. He saw half-knowledge from social media ruining careers.',
    'He decided to come back — not to retire, but to rebuild. That’s why he created AKMICS Sailpreneur Academy. Not a coaching centre. Not a content channel. A real academy by a real sailor.',
  ] },
];
const areas = [
  { icon: 'compass', title: 'Career direction', text: 'Profile assessment, department choice and a personal roadmap built on how ships really work.' },
  { icon: 'chat', title: 'Interview mastery', text: 'Realistic mock interviews and feedback, so the real interview feels familiar.' },
  { icon: 'document', title: 'Documents & joining', text: 'Step-by-step guidance through CDC, STCW, medical, visa and pre-embarkation.' },
  { icon: 'ship', title: 'Life at sea', text: 'Honest insight into crew life, routines and growing your career onboard.' },
];
---
<section class="section">
  <div class="wrap split split--reverse">
    <figure class="split-media framed" data-reveal>
      <Img name="ankur-uniform" alt="Ankur Kumar Mishra in uniform on a cruise ship deck" sizes="(max-width: 900px) 90vw, 40vw" />
      <figcaption>“If your dream is real, your mentor should be real too.”</figcaption>
    </figure>
    <div class="split-copy" data-reveal>
      <p class="eyebrow">Founder — AKMICS Sailpreneur Academy</p>
      <h2>Ankur Kumar Mishra — <em>your career captain.</em></h2>
      <p class="lead">11+ Years Royal Caribbean Veteran · From The Grand, New Delhi to the world’s largest cruise ships</p>
      <p>Every dream has a starting point. His started in a Hotel Management classroom — and took him through a 5-star hotel in New Delhi, the hospitality capital of Dubai and more than eleven years with Royal Caribbean International.</p>
      <ol class="mentor-timeline">
        {timeline.map((item) => <li><span><Icon name={item.icon} size={20} /></span><div><strong>{item.title}</strong><p>{item.text}</p></div></li>)}
      </ol>
    </div>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <SectionHeading eyebrow="The founder’s story" title="From a classroom <em>to the world’s oceans.</em>" />
    <ol class="story-chapters">
      {chapters.map((chapter, i) => (
        <li data-reveal>
          <p class="story-chapter-label"><span>{String(i + 1).padStart(2, '0')}</span>{chapter.label}</p>
          <div>
            <h3>{chapter.title}</h3>
            {chapter.paras.map((para) => <p>{para}</p>)}
          </div>
        </li>
      ))}
    </ol>
    <div class="mission-card" data-reveal>
      <p class="eyebrow">His mission</p>
      <p class="mission-text">Give everything he learnt in 11+ years at Royal Caribbean — from The Grand to Dubai to 50+ countries and 65+ islands — to the next generation. No fake promises. No YouTube theory. Only real, step-by-step guidance from someone who has actually lived it.</p>
      <blockquote><p>“If your dream is real, your mentor should be real too.”</p><cite>Ankur Kumar Mishra</cite></blockquote>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <SectionHeading eyebrow="How Ankur mentors" title="A profile. A plan. <em>A professional mindset.</em>" href="/mentorship-program/" linkText="See all programs" />
    <ul class="feature-grid">
      {areas.map((area, i) => <li data-reveal style={`--i:${i}`}><Icon name={area.icon} size={30} stroke={1.3} /><h3>{area.title}</h3><p>{area.text}</p></li>)}
    </ul>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <SectionHeading eyebrow="Students he has guided" title="Proof in <em>every journey.</em>" href="/success-stories/" linkText="All success stories" />
    <Stories />
    <div class="center-cta"><Button href="/contact/" variant="navy">Talk to Ankur’s team</Button></div>
  </div>
</section>
