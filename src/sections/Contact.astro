---
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { brand, tel } from '../data/site';
---
<section class="section contact-section">
  <div class="wrap contact-grid">
    <div class="contact-info" data-reveal>
      <p class="eyebrow">From wherever you are to your next horizon</p>
      <h2>A conversation can change <em>your direction.</em></h2>
      <p class="lead">Talk to our team about your background and the cruise career you’re dreaming of.</p>
      <div class="contact-tiles">
        {brand.phones.map((phone, i) => (
          <a class="contact-tile" href={tel(phone)}>
            <Icon name="phone" size={24} stroke={1.3} />
            <span><small>{i === 0 ? 'Call the academy' : 'Alternate number'}</small><strong>{phone}</strong></span>
          </a>
        ))}
        <a class="contact-tile" href={`mailto:${brand.email}`}>
          <Icon name="mail" size={24} stroke={1.3} />
          <span><small>Email the academy</small><strong>{brand.email}</strong></span>
        </a>
        <div class="contact-tile">
          <Icon name="pin" size={24} stroke={1.3} />
          <span><small>Our address</small><strong>{brand.address}</strong></span>
        </div>
        {brand.instagram.map((account) => (
          <a class="contact-tile" href={account.url} target="_blank" rel="noopener noreferrer">
            <Icon name="instagram" size={24} stroke={1.3} />
            <span><small>Follow on Instagram</small><strong>{account.handle}</strong></span>
          </a>
        ))}
      </div>
      <p class="note-small">Please call ahead to book a counselling call with our team.</p>
    </div>
    <div data-reveal><ContactForm /></div>
  </div>
</section>
