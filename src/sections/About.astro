---
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Stats from '../components/Stats.astro';
import Trust from '../components/Trust.astro';
import Experts from '../components/Experts.astro';
import { brand } from '../data/site';
const principles = [
  { icon: 'compass', title: 'Start with your background.', text: 'Every journey begins with a profile assessment — your education, experience, interests and questions — before choosing a department.' },
  { icon: 'chat', title: 'Prepare for what matters.', text: 'A clearer CV, realistic mock interviews, hospitality and USPH knowledge, and guidance through STCW, CDC, medical and visa steps.' },
  { icon: 'shield', title: 'Keep it honest.', text: 'No fake promises. We prepare you thoroughly and transparently — employers, recruiters and authorities make the final decisions.' },
];
---
<section class="section">
  <div class="wrap split">
    <div class="split-copy" data-reveal>
      <p class="eyebrow">The academy</p>
      <h2>Real sea experience, <em>shared from Dehradun.</em></h2>
      <p class="lead">AKMICS — Sailpreneur Academy is the cruise-career mentorship brand of {brand.company}.</p>
      <p>For anyone dreaming of a cruise career, the hardest part is often knowing where to begin. AKMICS brings career guidance, hospitality knowledge, interview preparation, documentation guidance and personal development into one mentor-led journey.</p>
      <p>The academy was founded by Ankur Kumar Mishra after twelve years working at sea — across fifty countries and sixty-five islands. His mission is simple: give young people from Dehradun and across India the honest guidance he wished he had.</p>
      <div class="btn-row"><Button href="/our-mentor/" variant="navy">Meet the founder</Button><Button href="/mentorship-program/" variant="outline">Explore programs</Button></div>
    </div>
    <div class="collage" data-reveal>
      <figure class="collage-main"><Img name="dehradun-valley" sizes="(max-width: 900px) 90vw, 40vw" /></figure>
      <figure class="collage-logo"><Img name="logo-card" alt="Ankur Kumar Mishra Sailpreneur logo — Navigate Your Dream Cruise Career" sizes="(max-width: 900px) 50vw, 18vw" /></figure>
      <p class="collage-note"><Icon name="pin" size={18} /><span>43, D.A.V. PG College Road, Dehradun</span></p>
    </div>
  </div>
</section>

<section class="section section--navy">
  <div class="wrap">
    <SectionHeading align="center" tone="dark" eyebrow="By the numbers" title="Experience you can <em>count on.</em>" />
    <div data-countup><Stats /></div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <SectionHeading eyebrow="The way we guide" title="Practical. Personal. <em>Transparent.</em>" />
    <ol class="principles">
      {principles.map((item, i) => <li data-reveal style={`--i:${i}`}><Icon name={item.icon} size={30} stroke={1.3} /><h3>{item.title}</h3><p>{item.text}</p></li>)}
    </ol>
  </div>
</section>

<section class="section section--tint">
  <div class="wrap">
    <SectionHeading align="center" eyebrow="Building careers at sea · Building trust at home" title="Why students &amp; parents <em>trust AKMICS.</em>" />
    <Trust />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <SectionHeading eyebrow="People behind the preparation" title="Our expert <em>panel.</em>" text="Cruise hospitality, hotel operations, language and personal development — five perspectives, one shared purpose." href="/expert-panel/" linkText="Meet the panel" />
    <Experts tone="light" />
  </div>
</section>
