---
import { departments, brand, tel } from '../data/site';
import Icon from './Icon.astro';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
---
<div class="form-panel" id="enquiry">
  <p class="eyebrow">Enquiry form</p>
  <h2>Tell us where you’d <br />like to <em>go next.</em></h2>
  <p class="form-intro">{endpoint ? 'Share your background and our team will get back to you.' : 'Prepare your enquiry below, then call our team — or bring it with you to the academy.'}</p>
  <form id="contact-form" data-endpoint={endpoint} novalidate>
    <div class="form-grid">
      <div class="field"><label for="name">Full name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="100" placeholder="Your full name" /></div>
      <div class="field"><label for="phone">Phone number <span aria-hidden="true">*</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[+0-9 \(\)\-]{7,20}" maxlength="20" placeholder="+91 …" /></div>
      <div class="field"><label for="email">Email <span class="optional">(optional)</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="180" placeholder="you@example.com" /></div>
      <div class="field"><label for="profession">Education / profession <span aria-hidden="true">*</span></label><input id="profession" name="profession" required maxlength="160" placeholder="Student, graduate, hospitality…" /></div>
      <div class="field field--full"><label for="department">Interested department <span class="optional">(optional)</span></label>
        <div class="select-wrap"><select id="department" name="department"><option value="">I’m still exploring</option>{departments.map((dept) => <option value={dept.slug}>{dept.name}</option>)}</select></div>
      </div>
      <div class="field field--full"><label for="message">How can we help? <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="4" required minlength="10" maxlength="2000" placeholder="Tell us about your goals and the guidance you need."></textarea></div>
    </div>
    <div class="honey" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
    <label class="consent"><input name="consent" type="checkbox" required /><span>I have read the <a href="/privacy-policy/">privacy notice</a>{endpoint ? ' and agree to be contacted about this enquiry.' : '. I understand that preparing this enquiry does not send it to AKMICS.'}</span></label>
    <button type="submit" class="btn btn--gold btn--block" disabled><span>{endpoint ? 'Send Enquiry' : 'Prepare My Enquiry'}</span><Icon name="arrow" size={18} /></button>
    <noscript><p class="form-note">Please call the academy on {brand.phones[0]} to make your enquiry.</p></noscript>
    <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    <a id="download-enquiry" hidden class="text-link" download="AKMICS-enquiry.txt">Download your enquiry ↓</a>
    <p class="form-note">{endpoint ? 'Please do not include identity documents or sensitive financial or medical information.' : <>Online delivery isn’t switched on yet, so nothing leaves your browser. For the fastest response call <a href={tel(brand.phones[0])}>{brand.phones[0]}</a>.</>}</p>
  </form>
</div>
