---
// Enquiry form. Works without JavaScript (native validation + POST → 303 /thank-you/);
// src/scripts/contact-form.ts enhances it with inline validation and a background JSON send.
import { departments, brand, tel, whatsappHref } from '../data/site';
import { LIMITS } from '../lib/enquiry-validation';
import Icon from './Icon.astro';
interface Props { formType?: string }
const { formType = 'Contact page enquiry' } = Astro.props;
const field = (id: string) => ({ id, name: id, 'aria-describedby': `${id}-error` });
---
<div class="form-panel" id="enquiry">
  <p class="eyebrow">Enquiry form</p>
  <h2>Tell us where you’d <br />like to <em>go next.</em></h2>
  <p class="form-intro">Share your background and our team will get back to you. Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>
  <form id="contact-form" action="/api/enquiry" method="post" data-whatsapp={whatsappHref()}>
    <div id="form-summary" class="form-summary" role="alert" tabindex="-1" hidden></div>
    <div class="form-grid">
      <div class="field">
        <label for="name">Full name <span aria-hidden="true">*</span></label>
        <input {...field('name')} autocomplete="name" required minlength={LIMITS.name.min} maxlength={LIMITS.name.max} placeholder="Your full name" />
        <p class="field-error" id="name-error" hidden></p>
      </div>
      <div class="field">
        <label for="phone">Phone / WhatsApp number <span aria-hidden="true">*</span></label>
        <input {...field('phone')} type="tel" autocomplete="tel" inputmode="tel" required pattern="[+0-9 \(\)\.\-]{10,20}" maxlength={LIMITS.phoneChars.max} placeholder="+91 98765 43210" />
        <p class="field-error" id="phone-error" hidden></p>
      </div>
      <div class="field">
        <label for="email">Email <span aria-hidden="true">*</span></label>
        <input {...field('email')} type="email" autocomplete="email" required maxlength={LIMITS.email.max} placeholder="you@example.com" />
        <p class="field-error" id="email-error" hidden></p>
      </div>
      <div class="field">
        <label for="profession">Education / profession <span aria-hidden="true">*</span></label>
        <input {...field('profession')} required minlength={LIMITS.profession.min} maxlength={LIMITS.profession.max} placeholder="Student, graduate, hospitality…" />
        <p class="field-error" id="profession-error" hidden></p>
      </div>
      <div class="field field--full">
        <label for="department">Interested department <span class="optional">(optional)</span></label>
        <div class="select-wrap"><select {...field('department')}><option value="">I’m still exploring</option>{departments.map((dept) => <option value={dept.slug}>{dept.name}</option>)}</select></div>
        <p class="field-error" id="department-error" hidden></p>
      </div>
      <div class="field field--full">
        <label for="message">How can we help? <span aria-hidden="true">*</span></label>
        <textarea {...field('message')} rows="4" required minlength={LIMITS.message.min} maxlength={LIMITS.message.max} placeholder="Tell us about your goals and the guidance you need."></textarea>
        <p class="field-error" id="message-error" hidden></p>
      </div>
    </div>
    <div class="honey" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
    <input type="hidden" name="form_type" value={formType} />
    <input type="hidden" name="started" value="" />
    <input type="hidden" name="page" value="" />
    <div class="consent-field">
      <label class="consent"><input id="consent" name="consent" type="checkbox" value="yes" required aria-describedby="consent-error" /><span>I have read the <a href="/privacy-policy/">privacy policy</a> and agree to be contacted about this enquiry. <span aria-hidden="true">*</span></span></label>
      <p class="field-error" id="consent-error" hidden></p>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn--gold btn--block"><span>Send Enquiry</span><Icon name="arrow" size={18} /></button>
      <button type="button" class="btn btn--outline btn--block form-whatsapp" hidden><span>Send via WhatsApp</span></button>
    </div>
    <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    <p class="form-note">Please do not include identity documents or financial or medical details. Prefer to talk? Call <a href={tel(brand.phones[0])}>{brand.phones[0]}</a> or email <a href={`mailto:${brand.email}`}>{brand.email}</a>.</p>
  </form>
</div>
