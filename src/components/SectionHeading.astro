---
import Button from './Button.astro';
interface Props { eyebrow: string; title: string; text?: string; href?: string; linkText?: string; align?: 'split' | 'center'; tone?: 'light' | 'dark' }
const { eyebrow, title, text, href, linkText = 'Explore more', align = 'split', tone = 'light' } = Astro.props;
---
<div class:list={['section-heading', `section-heading--${align}`, tone === 'dark' && 'on-dark']} data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 set:html={title} />
    {text && <p class="lead">{text}</p>}
  </div>
  {href && <Button href={href} variant={tone === 'dark' ? 'ghost' : 'outline'}>{linkText}</Button>}
</div>
