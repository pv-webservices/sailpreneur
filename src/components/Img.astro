---
import { media, generatedAlt } from '../lib/media';
interface Props { name: string; alt?: string; sizes?: string; class?: string; priority?: boolean; decorative?: boolean }
const { name, alt, sizes = '100vw', class: className, priority = false, decorative = false } = Astro.props;
const image = media(name);
const text = decorative ? '' : alt ?? generatedAlt(name);
---
<img
  class={className}
  src={image.src}
  srcset={image.srcset}
  sizes={sizes}
  width={image.width}
  height={image.height}
  alt={text}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : undefined}
/>
