---
import { brand, nav, tel } from '../data/site';
import Icon from './Icon.astro';
const current = Astro.url.pathname;
const isCurrent = (url: string) => (url === '/' ? current === '/' : current.startsWith(url));
const applyHref = Astro.url.pathname.startsWith('/contact') ? '#enquiry' : '/contact/';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="AKMICS Sailpreneur Academy — home">
      <img src="/media/emblem-120.webp" width="46" height="43" alt="" />
      <span class="brand-text"><strong>AKMICS</strong><small>Sailpreneur Academy</small></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      <ul>
        {nav.map(([url, label]) => <li><a href={url} aria-current={isCurrent(url) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <div class="nav-drawer-extra">
        <p class="eyebrow">Talk to our team</p>
        {brand.phones.map((phone) => <a class="drawer-phone" href={tel(phone)}><Icon name="phone" size={18} />{phone}</a>)}
        <a class="drawer-phone" href={`mailto:${brand.email}`}><Icon name="mail" size={18} />{brand.email}</a>
        <a class="btn btn--gold" href={applyHref}><span>Apply Now</span><Icon name="arrow" size={18} /></a>
      </div>
    </nav>
    <div class="header-actions">
      <div class="header-phones">
        <Icon name="phone" size={18} />
        <span>{brand.phones.map((phone) => <a href={tel(phone)}>{phone}</a>)}</span>
      </div>
      <a class="btn btn--gold btn--sm header-cta" href={applyHref}><span>Apply Now</span><Icon name="arrow" size={16} /></a>
      <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu">
        <span class="menu-lines" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>
