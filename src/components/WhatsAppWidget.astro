---
import { whatsappHref } from '../data/site';
---
<a
  class="whatsapp-widget"
  href={whatsappHref('Hello Sailpreneur! I would like to know more about cruise career mentorship.')}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp at +91 91852 82229 (opens in a new tab)"
>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M20.52 3.48A11.9 11.9 0 0 0 12.05 0C5.47 0 .12 5.35.12 11.93c0 2.1.55 4.16 1.6 5.98L0 24l6.25-1.64a11.9 11.9 0 0 0 5.8 1.48h.01c6.58 0 11.93-5.35 11.94-11.93a11.85 11.85 0 0 0-3.48-8.43ZM12.06 21.82a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.71.97.99-3.62-.24-.37a9.86 9.86 0 0 1-1.51-5.28c0-5.47 4.45-9.92 9.92-9.92a9.85 9.85 0 0 1 7.01 2.91 9.85 9.85 0 0 1 2.9 7.01c0 5.46-4.45 9.89-9.96 9.89Zm5.44-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.21 5.08 4.5.71.3 1.26.49 1.69.62.71.22 1.36.19 1.87.11.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z" />
    </svg>
</a>

<style>
  .whatsapp-widget {
    position: fixed;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: calc(1.5rem + env(safe-area-inset-bottom));
    z-index: 80;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: #147d45;
    color: #fff;
    box-shadow: var(--shadow);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .whatsapp-widget:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .whatsapp-widget:focus-visible { outline: 3px solid var(--gold-700); outline-offset: 4px; }
  :global(body.menu-open) .whatsapp-widget { visibility: hidden; }
  @media (max-width: 767px) {
    .whatsapp-widget { right: max(1rem, env(safe-area-inset-right)); bottom: calc(6rem + env(safe-area-inset-bottom)); width: 3rem; height: 3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .whatsapp-widget { transition: none; }
    .whatsapp-widget:hover { transform: none; }
  }
</style>
