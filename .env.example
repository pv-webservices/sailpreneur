# Set the approved public origin before building for publication.
PUBLIC_SITE_URL=
# HTTPS provider endpoint accepting form-urlencoded POST requests with CORS.
# It must provide server-side validation, rate limiting, spam protection,
# approved privacy/retention terms, and a JSON { success: true } acknowledgement.
PUBLIC_FORM_ENDPOINT=

# --- AI image generation (server-side scripts only; never prefix with PUBLIC_) ---
OPENAI_API_KEY=
# Optional overrides — defaults live in scripts/images/config.mjs
# IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# IMAGE_QUALITY_DEFAULT=medium
# IMAGE_QUALITY_PREMIUM=high
