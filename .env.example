# Copy to .env for local use. Never commit real values. In production these live in
# Netlify → Site configuration → Environment variables (see README "Enquiry email").

# --- Enquiry email (Netlify Function netlify/functions/enquiry.mts) ---
# Zoho Mail (India data centre), SSL on port 465.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# The mailbox that sends the enquiry (must be the Zoho account below or an alias of it).
SMTP_USER=info@cruisejobmentor.com
# Zoho app-specific password (Zoho Mail → Settings → Security → App Passwords). Secret.
SMTP_PASS=
# Where enquiries are delivered.
MAIL_TO=info@cruisejobmentor.com
# The From address. Keep it equal to SMTP_USER so Zoho accepts it and SPF/DKIM/DMARC pass.
MAIL_FROM=info@cruisejobmentor.com
# Optional: extra allowed origins for the form, comma-separated (the live domain, www,
# *.netlify.app previews and localhost are already allowed).
ALLOWED_ORIGINS=

# --- Build (optional) ---
# Canonical origin. Defaults to https://cruisejobmentor.com; only change for a staging build.
PUBLIC_SITE_URL=
# "true" builds every page as noindex (set automatically for Netlify deploy previews).
PUBLIC_NOINDEX=

# --- AI image generation (local scripts only; never prefix with PUBLIC_) ---
OPENAI_API_KEY=
# Optional overrides — defaults live in scripts/images/config.mjs
# IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# IMAGE_QUALITY_DEFAULT=medium
# IMAGE_QUALITY_PREMIUM=high
